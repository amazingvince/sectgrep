{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentityLedger",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "document": {
      "type": "string"
    },
    "next_id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/AddressableUnit"
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IdentityTransition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "next_id",
    "revisions",
    "transitions"
  ],
  "$defs": {
    "AddressableUnit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "regions",
        "content_sha256"
      ]
    },
    "IdentityTransition": {
      "type": "object",
      "properties": {
        "effective": {
          "type": "string"
        },
        "from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "type": "string"
        },
        "receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "effective",
        "from",
        "to",
        "basis"
      ]
    }
  }
}
