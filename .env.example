# Copy to .env (gitignored). Keys live here or in the shell, never in the repository.
# Read by sect-convert (transcriber boundary, API path), the Pi example, and the ingest harness.

# Hosted model: OpenRouter with a cheap vision-capable model (docs/decisions.md #41).
SECT_MODEL_PROVIDER=openrouter
SECT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# z-ai/glm-5.3-flash is what OpenRouter's alias ~z-ai/glm-flash-latest resolves to today.
# Pick a model whose provider keeps no records when that matters, and set
# SECT_MODEL_NO_RETENTION=1 to route only to providers that do not retain prompts.
SECT_MODEL=z-ai/glm-5.3-flash
SECT_MODEL_NO_RETENTION=0
OPENROUTER_API_KEY=

# Scanned pages: the transcriber pair. Primary is a local vLLM server when SECT_OCR_SERVER is
# set (packages/sect-convert/bakeoff/scripts/serve-pair.sh); the secondary defaults to the hosted
# model above when OPENROUTER_API_KEY is set. Any OpenAI-compatible endpoint works for either.
# SECT_OCR_SERVER=http://127.0.0.1:8000/v1
# SECT_OCR_PRIMARY=allenai/olmOCR-2-7B-1025
# SECT_OCR_SECONDARY_SERVER=
# SECT_OCR_SECONDARY=
# SECT_OCR_API_KEY=

# The sect binary for validators and examples, when it is not on PATH.
# SECT_BIN=target/release/sect
