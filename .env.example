# Copy to .env (gitignored). Keys live here or in the shell, never in the repository.
# Read by sect-convert (transcriber boundary, API path), the Pi example, and the ingest harness.

# Hosted model: OpenRouter with a cheap vision-capable model (docs/decisions.md #41).
SECT_MODEL_PROVIDER=openrouter
SECT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# Model selected for the recorded pilot; verify availability before a new hosted run.
# Pick a model whose provider keeps no records when that matters, and set
# SECT_MODEL_NO_RETENTION=1 to route only to providers that do not retain prompts.
SECT_MODEL=z-ai/glm-5.3-flash
SECT_MODEL_NO_RETENTION=0
OPENROUTER_API_KEY=
# The verifier (spec D.3) is answer-blind and runs on a different model family than ingest
# (docs/decisions.md #43); same key, same knobs.
SECT_VERIFIER_PROVIDER=openrouter
# Dated ids keep runs reproducible; the plain alias floats. The vision variant is used only when a
# judgment needs the page image (none does yet).
SECT_VERIFIER_MODEL=deepseek/deepseek-v4-flash-0731
SECT_VERIFIER_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
# Parallelism: agents and verifier calls in flight against the hosted API, pages in flight
# against the transcriber servers (vLLM batches concurrent requests).
SECT_INGEST_CONCURRENCY=8
SECT_VERIFIER_CONCURRENCY=12
SECT_OCR_CONCURRENCY=4

# Scanned pages: configure both transcriber endpoints explicitly. The local pair can
# be served with packages/sect-convert/bakeoff/scripts/serve-pair.sh. A hosted-model key
# alone does not enable OCR or its second reading. Any OpenAI-compatible endpoint works.
# SECT_OCR_SERVER=http://127.0.0.1:8000/v1
# SECT_OCR_PRIMARY=allenai/olmOCR-2-7B-1025
# SECT_OCR_SECONDARY_SERVER=
# SECT_OCR_SECONDARY=
# SECT_OCR_API_KEY=

# The sect binary for validators and examples, when it is not on PATH.
# SECT_BIN=target/release/sect
