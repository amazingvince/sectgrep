# Linux is the reference platform (GOAL.md section 4); keep LF in the repository on every OS.
* text=auto eol=lf
*.png binary
*.pdf binary
*.bin binary
*.json.gz binary
# Historical reports and evaluation bindings are byte-addressed evidence.
# Keep their original line endings on checkout and when staging.
eval/results/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
eval/corpora/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
eval/corpora/*.jsonl -text whitespace=trailing-space,space-before-tab,cr-at-eol
